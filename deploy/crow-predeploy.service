# Template: deploy/setup.sh installs it to /etc/systemd/system.
# Started by deploy/deploy.sh: backs up the data dir before switching to the new build at /opt/crow/next.
[Unit]
Description=crow pre-deploy data backup

[Service]
Type=oneshot
User=crow
Group=crow
ExecStart=/opt/crow/next/deploy/backup.sh --backup-only
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/crow /var/backups/crow
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
